    <Modal
        visible={showVerificationModal}
        transparent
        animationType="slide"
        onRequestClose={() => setShowVerificationModal(false)}
      >
        <KeyboardAvoidingView
          behavior={Platform.OS === "ios" ? "padding" : "height"}
          style={{ flex: 1 }}
        >
          <View className="flex-1 items-center justify-center bg-overlay-medium">
            <View className="mx-6 w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">
              <View className="mb-4 items-center">
                <View className="mb-4 h-16 w-16 items-center justify-center rounded-full bg-brand-purple/10">
                  <MaterialIcons name="email" size={32} color="#6c4ef5" />
                </View>
                <Text className="text-[20px] font-poppins-bold text-neutral-text-primary">
                  Check your email
                </Text>
                <Text className="mt-2 text-center text-[14px] font-poppins-regular text-neutral-text-secondary">
                  We've sent a 6-digit verification code to your email. Enter it
                  below to continue.
                </Text>
              </View>

              {/* 6-digit Code Input */}
              <View className="mb-6 flex-row justify-between gap-2">
                {[0, 1, 2, 3, 4, 5].map((index) => (
                  <TextInput
                    key={index}
                    className="h-14 w-12 items-center justify-center rounded-xl border-2 border-neutral-border bg-white text-center text-[24px] font-poppins-bold text-neutral-text-primary"
                    value={verificationCode[index] || ""}
                    onChangeText={(text) => {
                      const newCode = verificationCode.split("");
                      newCode[index] = text;
                      handleCodeChange(newCode.join(""));
                    }}
                    keyboardType="number-pad"
                    maxLength={1}
                    selectTextOnFocus
                  />
                ))}
              </View>

              <Pressable
                onPress={() => setShowVerificationModal(false)}
                className="rounded-xl bg-neutral-surface py-3"
              >
                <Text className="text-center text-[14px] font-poppins-medium text-neutral-text-secondary">
                  Cancel
                </Text>
              </Pressable>
            </View>
          </View>
        </KeyboardAvoidingView>
      </Modal>